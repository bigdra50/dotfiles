{
  "//": [
    "prh を 2 つ読んでいる。textlint は同じルール id を 1 つしか持てないため、2 つ目は",
    "package 名そのもの (textlint-rule-prh) を key にして別インスタンスとして読ませる。",
    "  prh                → prh-writing-style.yml を error で当てる。実測 0 件、",
    "                       つまり人が書いた文には出てこなかったパターンだけを入れてある。",
    "  textlint-rule-prh  → prh-business.yml を warning で当てる。黒と断定できない語を置く。",
    "warning は exit code に影響しない。CI も PR body lint も落ちないが、Write|Edit の hook は",
    "出力の有無で差し戻すため、書いた直後のモデルには届く。",
    "",
    "preset-ai-words-ja は語そのものを形態素で拾う (ai-writing は構造を見る)。黒と断定できない語が",
    "多いので warning。allows には、このリポジトリの md 51 件に当てて 37 件すべてが正当な用法だった",
    "語を置く (2026-09-15 の測定。検査・実測・正本はこの repo の用語)。効く は prh-business が",
    "言い換え先付きで扱うので、二重に指摘しないよう allows に入れる。no-short-topic-comma は",
    "「結論は、」のような短い主題の読点を見るルールで、指摘が多くなるので入れない。"
  ],
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": { "max": 150, "skipUrlStringLink": true },
      "max-ten": { "max": 3 },
      "max-kanji-continuous-len": { "max": 6 },
      "no-doubled-joshi": { "min_interval": 1 },
      "no-double-negative-ja": true,
      "no-doubled-conjunction": true,
      "no-doubled-conjunctive-particle-ga": true,
      "ja-no-weak-phrase": true,
      "ja-no-redundant-expression": true,
      "ja-no-abusage": true,
      "ja-no-successive-word": true,
      "no-hankaku-kana": true,
      "no-zero-width-spaces": true,
      "no-invalid-control-character": true,
      "no-nfd": true,
      "no-unmatched-pair": true,

      "ja-no-mixed-period": false,
      "max-comma": false,
      "arabic-kanji-numbers": false,
      "no-mix-dearu-desumasu": false,
      "no-dropping-the-ra": false,
      "no-exclamation-question-mark": false,
      "ja-unnatural-alphabet": false
    },
    "@textlint-ja/preset-ai-writing": {
      "no-ai-list-formatting": true,
      "no-ai-hype-expressions": true,
      "no-ai-emphasis-patterns": true,
      "no-ai-colon-continuation": true,

      "ai-tech-writing-guideline": false
    },
    "preset-ai-words-ja": {
      "no-ai-words": {
        "severity": "warning",
        "allows": ["効く", "検査", "実測", "経路", "正本", "/壊れ/", "漏れ", "/走[るらりっれろ]/", "潰す", "断定"]
      },
      "no-short-topic-comma": false
    },
    "no-strong-emphasis": true,
    "period-in-list-item": {
      "periodMark": "",
      "periodMarks": ["。", "．"],
      "ignoreLinkEnd": true,
      "allowOrderedList": false,
      "forceAppendPeriod": false
    },
    "prh": {
      "rulePaths": ["./prh-writing-style.yml"]
    },
    "textlint-rule-prh": {
      "severity": "warning",
      "rulePaths": ["./prh-business.yml"]
    }
  }
}
