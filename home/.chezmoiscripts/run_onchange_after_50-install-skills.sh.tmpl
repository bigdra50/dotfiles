{{- /* claude-skills モジュールが有効なときだけ、中身のあるスクリプトになる。
       chezmoi は、描画した結果が空のスクリプトを実行しない。 */ -}}
{{- $on := includeTemplate "dotfiles/enabled" . | fromJson -}}
{{- if has "claude-skills" $on -}}
{{- $tree := .chezmoi.workingTree -}}
#!/usr/bin/env bash
# apm で skills と agents を入れる。実装は scripts/setup/skills.sh。
#
# chezmoi は、このスクリプトの描画結果が前回と変わったときだけ実行する (run_onchange)。
# 入力のハッシュを下に並べて、どれかが変わると描画結果も変わるようにする。
#   マニフェスト   {{ include (joinPath $tree ".apm/apm.yml") | sha256sum }}
#   lock           {{ include (joinPath $tree ".apm/apm.lock.yaml") | sha256sum }}
#   導入の処理     {{ include (joinPath $tree "scripts/setup/skills.sh") | sha256sum }}
{{- range glob (joinPath $tree ".apm/agents/*") | sortAlpha }}
#   agent          {{ include . | sha256sum }} {{ base . }}
{{- end }}
#
# install に成功すると、処理が lock をリポジトリへ書き戻すことがある。
# そのときは lock のハッシュが変わるので、次の apply でもう一度だけ走る。
set -euo pipefail

# apm は、ユーザースコープの置き場所を HOME から決める。配置先を HOME として渡す
export HOME={{ .chezmoi.destDir | quote }}
export INTERACTIVE=false
exec bash {{ joinPath $tree "scripts/setup/skills.sh" | quote }}
{{- end -}}
