#!/usr/bin/env bash

#MISE description="Apply the dotfiles textlint config to the current project"

# dotfiles の textlint 設定を任意のプロジェクトへ配る。
#
# 設定の正本は dotfiles 側の .claude/.textlintrc.json と 2 つの prh 辞書
# (.claude/prh-writing-style.yml, .claude/prh-business.yml)。
# ここでは複製するだけで、内容をこのファイルに持たない。両方に設定を書くと
# 「どちらが正か」が失われ、規範を更新しても配布先に反映されなくなる。
#
# 依存も dotfiles の .claude/package.json から読む。バージョンの二重管理を避ける。

set -euo pipefail

# ~/.config/mise は dotfiles へのシンボリックリンクなので -P で実体を辿る。
TASK_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd -P "$TASK_DIR/../../.." && pwd)"
SRC="$DOTFILES_DIR/.claude"
PROJECT_DIR="$(pwd)"

if [[ "$PROJECT_DIR" == "$DOTFILES_DIR" ]]; then
    echo "dotfiles 自身には既に設定がある。別のプロジェクトで実行すること。" >&2
    exit 1
fi
# .textlintrc.json が 2 つの辞書を rulePaths で参照しているので、片方でも欠けると
# 配布先の textlint が設定エラーで落ちる。存在確認と cp は必ず両方に対して行う。
for f in .textlintrc.json prh-writing-style.yml prh-business.yml package.json; do
    if [[ ! -f "$SRC/$f" ]]; then
        echo "正本が見つからない: $SRC/$f" >&2
        exit 1
    fi
done

echo "textlint 環境をセットアップ: $PROJECT_DIR"

if [[ ! -f package.json ]]; then
    npm init -y >/dev/null
    echo "  package.json を作成"
fi

# 依存は正本の package.json から名前@レンジで組み立てる。
deps=$(node -e '
const d = require(process.argv[1]).dependencies || {};
console.log(Object.entries(d).map(([k, v]) => k + "@" + v).join(" "));
' "$SRC/package.json")
# shellcheck disable=SC2086
# deps は「pkg@range pkg@range …」で、個別の引数へ分割させたいので展開する。
npm install --save-dev $deps

cp "$SRC/.textlintrc.json" .textlintrc.json
cp "$SRC/prh-writing-style.yml" prh-writing-style.yml
cp "$SRC/prh-business.yml" prh-business.yml
echo "  .textlintrc.json と prh 辞書 2 つを配置"

if [[ ! -f .gitignore ]] || ! grep -q '^node_modules/' .gitignore; then
    printf '\n# Dependencies\nnode_modules/\n' >>.gitignore
    echo "  .gitignore に node_modules/ を追加"
fi

cat <<'USAGE'

セットアップ完了。

  npx textlint '**/*.md'    # 検査
  npx textlint --stdin --stdin-filename body.md < body.md

--fix は使わないこと。prh の expected はリライト方針のヒントであって
置換文字列ではないため、自動修正すると文章が壊れる。
USAGE
